# TMDB — required
TMDB_READ_TOKEN=

# Supabase — optional. Without these, the log persists only in localStorage.
# Get them from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Impressum / Datenschutz — server-only, read at build time. Set them in
# Vercel (Settings → Environment Variables), not in the repo, then redeploy.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
# where the Supabase project stores data, e.g. "Frankfurt (EU)"
SUPABASE_REGION=
